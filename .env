# =========================
# App
# =========================
SECRET_KEY=change-me-in-production

# =========================
# Session / OTP
# =========================
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

# =========================
# Mail (Flask-Mail)
# =========================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-app-password
MAIL_DEFAULT_SENDER=your-email@example.com

# =========================
# Supabase Postgres (Preferred)
# Use ONE of the two DB config styles below.
# =========================

# Style A (recommended): full connection string
# Example format:
# postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres.fhhvlbbbbzxtiqztnint:omHZLsUXv5GbBco9@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# Style B (optional): split fields (used if SUPABASE_DB_URL is empty)
SUPABASE_DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=omHZLsUXv5GbBco9
SUPABASE_DB_SSLMODE=require

# Fallback alias (optional)
DATABASE_URL=

# =========================
# Supabase Project / Storage
# =========================
# Example: https://<project-ref>.supabase.co
SUPABASE_PROJECT_URL=https://fhhvlbbbbzxtiqztnint.supabase.co

