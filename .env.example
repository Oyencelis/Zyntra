# =========================
# App
# =========================
SECRET_KEY=change-me-in-production

# =========================
# Session / OTP
# =========================
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

# =========================
# Mail (Flask-Mail)
# =========================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-app-password
MAIL_DEFAULT_SENDER=your-email@example.com

# =========================
# Supabase Postgres (Preferred)
# Use ONE of the two DB config styles below.
# =========================

# Style A (recommended): full connection string
# Example format:
# postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=

# Style B (optional): split fields (used if SUPABASE_DB_URL is empty)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require

# Fallback alias (optional)
DATABASE_URL=

# =========================
# Supabase Project / Storage
# =========================
# Example: https://<project-ref>.supabase.co
SUPABASE_PROJECT_URL=

# IMPORTANT: server-side key for backend uploads (do not expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Public auth key for Supabase email/password auth
SUPABASE_ANON_KEY=

# Optional: where Supabase should redirect after email confirmation
SUPABASE_AUTH_REDIRECT_URL=

# Storage bucket for product + document uploads
SUPABASE_STORAGE_BUCKET=zyntra-uploads

# (Frontend-only, optional here for reference)
# SUPABASE_PUBLISHABLE_KEY=
